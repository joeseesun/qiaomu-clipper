{
	"manifest_version": 3,
	"default_locale": "en",
	"name": "乔木剪藏 · Obsidian + RSS",
	"homepage_url": "https://github.com/joeseesun/qiaomu-clipper",
	"version": "1.11.1",
	"description": "Save web pages to Obsidian and optionally submit their URL, title and content to Qiaomu RSS reader submissions.",
	"permissions": [
		"activeTab",
		"clipboardWrite",
		"nativeMessaging",
		"contextMenus",
		"sidePanel",
		"storage",
		"scripting",
		"declarativeNetRequest"
	],
	"host_permissions": [
		"http://*/*",
		"https://*/*"
	],
	"action": {
		"default_popup": "popup.html"
	},
	"side_panel": {
		"default_path": "side-panel.html"
	},
	"options_ui": {
		"page": "settings.html",
		"open_in_tab": true
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"https://www.youtube.com/embed/*",
				"https://www.youtube-nocookie.com/embed/*",
				"https://player.bilibili.com/*"
			],
			"js": ["video-clock.js"],
			"all_frames": true,
			"run_at": "document_start"
		},
		{
			"matches": [
				"http://*/*",
				"https://*/*"
			],
			"js": [
				"triple-key.js"
			],
			"all_frames": true,
			"run_at": "document_start"
		},
		{
			"matches": [
				"https://www.youtube.com/*"
			],
			"js": [
				"youtube-panel.js"
			],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://www.bilibili.com/video/*",
				"https://www.bilibili.com/list/*"
			],
			"js": [
				"bilibili-panel.js"
			],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"http://*/*",
				"https://*/*"
			],
			"js": [
				"content-loader.js"
			]
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"reader.css",
				"fonts/ZhuqueFangsong-Regular.woff",
				"reader-script.js",
				"browser-polyfill.min.js",
				"style.css",
				"side-panel.html",
				"flatten-shadow-dom.js",
				"highlighter.css"
			],
			"extension_ids": [
				"*"
			],
			"matches": [
				"*://*/*"
			]
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+O",
				"mac": "Command+Shift+O"
			},
			"description": "__MSG_commandOpenClipper__"
		},
		"quick_clip": {
			"suggested_key": {
				"default": "Alt+Shift+O",
				"mac": "Alt+Shift+O"
			},
			"description": "__MSG_commandQuickClip__"
		},
		"toggle_highlighter": {
			"suggested_key": {
				"default": "Alt+Shift+H",
				"mac": "Alt+Shift+H"
			},
			"description": "__MSG_commandToggleHighlighter__"
		},
		"open_editor": {
			"description": "__MSG_commandOpenEditor__"
		},
		"toggle_reader": {
			"suggested_key": {
				"default": "Alt+Shift+R",
				"mac": "Alt+Shift+R"
			},
			"description": "__MSG_commandToggleReader__"
		}
	}
}
