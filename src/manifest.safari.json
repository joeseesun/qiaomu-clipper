{
	"manifest_version": 3,
	"name": "乔木剪藏 · Obsidian + RSS",
	"homepage_url": "https://github.com/joeseesun/qiaomu-clipper",
	"version": "1.10.1",
	"description": "Save web pages to Obsidian and optionally submit their URL, title and content to Qiaomu RSS reader submissions.",
	"permissions": [
		"activeTab",
		"clipboardWrite",
		"contextMenus",
		"nativeMessaging",
		"storage",
		"scripting"
	],
	"host_permissions": [
		"<all_urls>",
		"http://*/*",
		"https://*/*"
	],
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"options_ui": {
		"page": "settings.html"
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"http://*/*",
				"https://*/*"
			],
			"js": [
				"triple-key.js"
			],
			"all_frames": true,
			"run_at": "document_start"
		},
		{
			"matches": [
				"https://www.youtube.com/*"
			],
			"js": [
				"youtube-panel.js"
			],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"http://*/*",
				"https://*/*"
			],
			"js": [
				"content-loader.js"
			]
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"reader.css",
				"fonts/ZhuqueFangsong-Regular.woff",
				"reader-script.js",
				"browser-polyfill.min.js",
				"style.css",
				"side-panel.html",
				"flatten-shadow-dom.js",
				"highlighter.css"
			],
			"extension_ids": [
				"*"
			],
			"matches": [
				"*://*/*"
			]
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+O",
				"mac": "Command+Shift+O"
			},
			"description": "Open Obsidian Clipper"
		},
		"quick_clip": {
			"suggested_key": {
				"default": "Alt+Shift+O",
				"mac": "Alt+Shift+O"
			},
			"description": "Quick clip"
		},
		"toggle_highlighter": {
			"suggested_key": {
				"default": "Alt+Shift+H",
				"mac": "Alt+Shift+H"
			},
			"description": "Toggle highlighter mode"
		},
		"open_editor": {
			"description": "__MSG_commandOpenEditor__"
		},
		"toggle_reader": {
			"suggested_key": {
				"default": "Alt+Shift+R",
				"mac": "Alt+Shift+R"
			},
			"description": "Toggle reading view"
		}
	}
}
