{
	"manifest_version": 3,
	"name": "乔木剪藏 · Obsidian + RSS",
	"homepage_url": "https://github.com/joeseesun/qiaomu-clipper",
	"version": "1.13.2",
	"description": "Save web pages to Obsidian and optionally submit their URL, title and content to Qiaomu RSS reader submissions.",
	"permissions": [
		"activeTab",
		"clipboardWrite",
		"contextMenus",
		"nativeMessaging",
		"storage",
		"scripting"
	],
	"host_permissions": [
		"<all_urls>",
		"http://*/*",
		"https://*/*"
	],
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"options_ui": {
		"page": "settings.html"
	},
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"http://*/*",
				"https://*/*"
			],
			"js": [
				"triple-key.js"
			],
			"all_frames": true,
			"run_at": "document_start"
		},
		{
			"matches": [
				"https://www.youtube.com/*"
			],
			"js": [
				"youtube-panel.js"
			],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://www.bilibili.com/video/*",
				"https://www.bilibili.com/list/*"
			],
			"js": [
				"bilibili-panel.js"
			],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://player.bilibili.com/*"
			],
			"js": [
				"bilibili-embed.js"
			],
			"all_frames": true,
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://www.xiaoyuzhoufm.com/episode/*"
			],
			"js": [
				"xiaoyuzhou-panel.js"
			],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"https://vimeo.com/*",
				"https://*.vimeo.com/*",
				"https://x.com/*",
				"https://*.x.com/*",
				"https://twitter.com/*",
				"https://*.twitter.com/*",
				"https://tiktok.com/*",
				"https://*.tiktok.com/*",
				"https://douyin.com/*",
				"https://*.douyin.com/*",
				"https://instagram.com/*",
				"https://*.instagram.com/*",
				"https://facebook.com/*",
				"https://*.facebook.com/*",
				"https://fb.watch/*",
				"https://*.fb.watch/*",
				"https://reddit.com/*",
				"https://*.reddit.com/*",
				"https://v.redd.it/*",
				"https://*.v.redd.it/*",
				"https://twitch.tv/*",
				"https://*.twitch.tv/*",
				"https://dailymotion.com/*",
				"https://*.dailymotion.com/*",
				"https://dai.ly/*",
				"https://*.dai.ly/*",
				"https://soundcloud.com/*",
				"https://*.soundcloud.com/*",
				"https://bandcamp.com/*",
				"https://*.bandcamp.com/*",
				"https://nicovideo.jp/*",
				"https://*.nicovideo.jp/*",
				"https://nico.ms/*",
				"https://*.nico.ms/*",
				"https://weibo.com/*",
				"https://*.weibo.com/*",
				"https://weibo.cn/*",
				"https://*.weibo.cn/*",
				"https://ximalaya.com/*",
				"https://*.ximalaya.com/*",
				"https://music.163.com/*",
				"https://*.music.163.com/*",
				"https://ted.com/*",
				"https://*.ted.com/*",
				"https://podcasts.apple.com/*",
				"https://*.podcasts.apple.com/*"
			],
			"js": [
				"web-panel.js"
			],
			"run_at": "document_idle"
		},
		{
			"matches": [
				"http://*/*",
				"https://*/*"
			],
			"js": [
				"content-loader.js"
			]
		}
	],
	"web_accessible_resources": [
		{
			"resources": [
				"reader.css",
				"fonts/ZhuqueFangsong-Regular.woff",
				"reader-script.js",
				"browser-polyfill.min.js",
				"style.css",
				"side-panel.html",
				"flatten-shadow-dom.js",
				"highlighter.css"
			],
			"extension_ids": [
				"*"
			],
			"matches": [
				"*://*/*"
			]
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'self'"
	},
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Ctrl+Shift+O",
				"mac": "Command+Shift+O"
			},
			"description": "Open Obsidian Clipper"
		},
		"quick_clip": {
			"suggested_key": {
				"default": "Alt+Shift+O",
				"mac": "Alt+Shift+O"
			},
			"description": "Quick clip"
		},
		"toggle_highlighter": {
			"suggested_key": {
				"default": "Alt+Shift+H",
				"mac": "Alt+Shift+H"
			},
			"description": "Toggle highlighter mode"
		},
		"open_editor": {
			"description": "__MSG_commandOpenEditor__"
		},
		"toggle_reader": {
			"suggested_key": {
				"default": "Alt+Shift+R",
				"mac": "Alt+Shift+R"
			},
			"description": "Toggle reading view"
		}
	}
}
